// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  password      String?
  phone         String?
  role          UserRole  @default(USER)
  isVerified    Boolean   @default(false)
  otpCode       String?
  otpExpires    DateTime?
  addresses     Address[]
  wishlist      Wishlist[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Address {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  street    String
  city      String
  state     String
  zip       String
  country   String
  isDefault Boolean @default(false)
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId String   @db.ObjectId
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)
  totalAmount Float       @default(0)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String   @db.ObjectId
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId   String   @db.ObjectId
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity    Int      @default(1)
  priceAtOrder Float    // price per unit at time of order
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Brand {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String    @unique
  logoUrl      String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

model Category {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String     @unique
  description    String?
  imageUrl       String?
  iconUrl        String?

  // Hierarchy
  parentId       String?    @db.ObjectId
  parent         Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories  Category[] @relation("SubCategories")

  // Materialized path helpers (fast tree + breadcrumbs)
  path           String     @default("")
  level          Int        @default(0)
  pathIds        String[]   @default([])

  // Visibility + ordering (navbar/admin)
  isActive       Boolean    @default(true)
  showInNav      Boolean    @default(true)
  displayOrder   Int        @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([parentId])
  @@index([path])
  @@index([level])
  @@index([isActive, showInNav])
}

model Product {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String           @unique
  description     String
  metaTitle       String?
  metaDescription String?
  categoryId      String           @db.ObjectId
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brandId         String?          @db.ObjectId
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  isTrending      Boolean          @default(false)
  rating          Float?            // cached average from Review
  ratingCount     Int              @default(0) // cached count from Review
  images          ProductImage[]
  variants        ProductVariant[]
  wishlist        Wishlist[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([brandId])
  @@index([isTrending])
}

model ProductVariant {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  color        String
  size         String
  stock        Int      @default(0)
  price        Float    // selling / discounted price
  actualPrice  Float?   // MRP / original price (optional; when set, show discount)
  productId    String   @db.ObjectId
  product      Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cartItems    CartItem[]
  orderItems   OrderItem[]
}

model ProductImage {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  driveUrl     String
  color        String?
  displayOrder Int     @default(0)
  productId    String  @db.ObjectId
  product      Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// FAQs: managed from admin, shown on homepage (first 6) and /faq page
model Faq {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

// Dynamic content editable from admin (top bar text, promo bar bg, etc.)
model SiteSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique  // e.g. "top_bar_text", "promo_bar_bg_color"
  value       String   @default("")
  type        String   @default("text")  // "text" | "color" | "image_url" | "richtext"
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
